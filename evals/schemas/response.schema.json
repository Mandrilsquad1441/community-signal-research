{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://community-signal-research.example/evals/response.schema.json",
  "title": "Community signal behavioral-evaluation response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "signal_id",
    "recommendation",
    "support_assessment",
    "independent_support",
    "excluded_or_collapsed_sources",
    "counterevidence",
    "wtp",
    "public_memo",
    "citations",
    "limitations",
    "next_test"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^case-[0-9]{2}-[a-z0-9-]+$"},
    "signal_id": {"type": "string", "pattern": "^sig-[a-z0-9-]+$"},
    "recommendation": {
      "enum": ["proceed", "validate_first", "do_not_proceed", "insufficient_evidence"]
    },
    "support_assessment": {
      "enum": ["unsupported", "anecdotal", "recurring", "well-corroborated"]
    },
    "independent_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "threads", "source_ids"],
      "properties": {
        "authors": {"type": "integer", "minimum": 0},
        "threads": {"type": "integer", "minimum": 0},
        "source_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^src-[a-z0-9]+$"},
          "uniqueItems": true
        }
      }
    },
    "excluded_or_collapsed_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "reason", "explanation"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^src-[a-z0-9]+$"},
          "reason": {
            "enum": ["duplicate_or_repost", "promotion", "unclear_promotion", "unknown_author", "out_of_scope", "other"]
          },
          "explanation": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    },
    "counterevidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_ids", "summary"],
      "properties": {
        "status": {"enum": ["present", "none_found_in_coverage", "not_established"]},
        "source_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^src-[a-z0-9]+$"},
          "uniqueItems": true
        },
        "summary": {"type": "string", "minLength": 1, "maxLength": 1200}
      }
    },
    "wtp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis", "source_ids", "summary"],
      "properties": {
        "level": {"enum": ["none", "anecdotal", "recurring"]},
        "basis": {"enum": ["none", "purchase_intent", "observed_payment", "mixed"]},
        "source_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^src-[a-z0-9]+$"},
          "uniqueItems": true
        },
        "summary": {"type": "string", "minLength": 1, "maxLength": 900}
      }
    },
    "public_memo": {"type": "string", "minLength": 1, "maxLength": 5000},
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "visibility", "locator", "source_file_sha256", "excerpt"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^src-[a-z0-9]+$"},
          "visibility": {"enum": ["public", "supplied_private"]},
          "locator": {"type": "string", "minLength": 1, "maxLength": 500},
          "source_file_sha256": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            ]
          },
          "excerpt": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "minLength": 1, "maxLength": 500}
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"visibility": {"const": "public"}},
              "required": ["visibility"]
            },
            "then": {
              "properties": {
                "source_file_sha256": {"type": "null"},
                "excerpt": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          },
          {
            "if": {
              "properties": {"visibility": {"const": "supplied_private"}},
              "required": ["visibility"]
            },
            "then": {
              "properties": {
                "source_file_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "excerpt": {"type": "null"}
              }
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 800},
      "uniqueItems": true
    },
    "next_test": {"type": "string", "minLength": 1, "maxLength": 1200}
  }
}
