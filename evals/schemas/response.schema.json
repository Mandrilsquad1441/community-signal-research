{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "signal_id",
    "recommendation",
    "support_assessment",
    "independent_support",
    "excluded_or_collapsed_sources",
    "counterevidence",
    "wtp",
    "public_memo",
    "citations",
    "limitations",
    "next_test"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "case_id": {
      "type": "string"
    },
    "signal_id": {
      "type": "string"
    },
    "recommendation": {
      "type": "string",
      "enum": ["proceed", "validate_first", "do_not_proceed", "insufficient_evidence"]
    },
    "support_assessment": {
      "type": "string",
      "enum": ["unsupported", "anecdotal", "recurring", "well-corroborated"]
    },
    "independent_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "threads", "source_ids"],
      "properties": {
        "authors": {
          "type": "integer"
        },
        "threads": {
          "type": "integer"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "excluded_or_collapsed_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "reason", "explanation"],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": ["duplicate_or_repost", "promotion", "unclear_promotion", "unknown_author", "out_of_scope", "other"]
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "counterevidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_ids", "summary"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["present", "none_found_in_coverage", "not_established"]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "wtp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis", "source_ids", "summary"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["none", "anecdotal", "recurring"]
        },
        "basis": {
          "type": "string",
          "enum": ["none", "purchase_intent", "observed_payment", "mixed"]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "public_memo": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "visibility", "locator", "source_file_sha256", "excerpt"],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "supplied_private"]
          },
          "locator": {
            "type": "string"
          },
          "source_file_sha256": {
            "type": ["string", "null"]
          },
          "excerpt": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_test": {
      "type": "string"
    }
  }
}
