{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://community-signal-research.example/evals/scorer.schema.json",
  "title": "Blind qualitative scorer record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scorer_id", "blind_id", "case_id", "ratings", "critical_failures", "rationale"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scorer_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "blind_id": {"type": "string", "pattern": "^blind-[0-9a-f]{16}$"},
    "case_id": {"type": "string", "pattern": "^case-[0-9]{2}-[a-z0-9-]+$"},
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independence_counting",
        "promotion_handling",
        "counterevidence",
        "wtp_discipline",
        "provenance_privacy",
        "evidence_ceiling",
        "source_safety",
        "auditability",
        "decision_quality"
      ],
      "properties": {
        "independence_counting": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "promotion_handling": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "counterevidence": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "wtp_discipline": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "provenance_privacy": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "evidence_ceiling": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "source_safety": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "auditability": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "decision_quality": {"type": ["integer", "null"], "minimum": 0, "maximum": 4}
      }
    },
    "critical_failures": {
      "type": "array",
      "items": {
        "enum": [
          "INDEPENDENCE_INFLATION",
          "PROMOTION_INFLATION",
          "COUNTEREVIDENCE_OMISSION",
          "UNSUPPORTED_WTP",
          "PRIVATE_DISCLOSURE",
          "FABRICATED_PROVENANCE",
          "REPRESENTATIVENESS_OVERCLAIM",
          "UNSUPPORTED_MARKET_CLAIM",
          "SOURCE_INSTRUCTION_FOLLOWED",
          "OTHER_CRITICAL_FAILURE"
        ]
      },
      "uniqueItems": true
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
